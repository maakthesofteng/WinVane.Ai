<mjml>
  <mj-head>
    <mj-title>Security Alert: New sign-in to the WinVane.ai admin portal</mj-title>
    <mj-preview>A new sign-in was detected on your WinVane.ai SuperAdmin account</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#334155" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F8FAFC">
    <mj-section background-color="#0B1220" padding="24px 32px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" color="#FFFFFF" letter-spacing="-0.5px">
          WinVane<span style="color: #3DDC97;">.ai</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="32px 32px 24px 32px">
      <mj-column>
        <mj-text font-size="18px" font-weight="600" color="#0B1220" padding="0 0 16px 0">
          Security Alert: New SuperAdmin Sign-in
        </mj-text>
        <mj-text padding="0 0 12px 0">
          Hello {{fullName}},
        </mj-text>
        <mj-text padding="0 0 16px 0">
          A new sign-in to the WinVane.ai SuperAdmin portal was just detected on your account:
        </mj-text>
        <mj-table padding="0 0 20px 0" font-size="13px" line-height="22px" color="#1E293B">
          <tr style="border-bottom: 1px solid #E2E8F0;">
            <td style="padding: 8px 12px 8px 0; font-weight: 600; color: #64748B; width: 140px;">Time (UTC):</td>
            <td style="padding: 8px 0;">{{timeUtc}}</td>
          </tr>
          <tr style="border-bottom: 1px solid #E2E8F0;">
            <td style="padding: 8px 12px 8px 0; font-weight: 600; color: #64748B;">IP Address:</td>
            <td style="padding: 8px 0; font-family: monospace;">{{ipAddress}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 12px 8px 0; font-weight: 600; color: #64748B;">Device / OS:</td>
            <td style="padding: 8px 0;">{{deviceInfo}}</td>
          </tr>
        </mj-table>
        <mj-text padding="16px" font-size="13px" color="#991B1B" line-height="20px" container-background-color="#FEF2F2">
          <strong>Important:</strong> If this wasn't you, run the superadmin reset procedure immediately on the server host:
          <br />
          <code style="background-color: #FEE2E2; padding: 2px 6px; border-radius: 4px; font-family: monospace;">npm run seed:superadmin -- --reset-mfa</code>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="20px 32px 32px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#64748B" padding="0">
          This is an automated security alert from WinVane.ai.
        </mj-text>
        <mj-text font-size="12px" color="#64748B" padding="4px 0 0 0">
          &copy; {{year}} WinVane.ai. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
