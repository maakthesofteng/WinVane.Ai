<mjml>
  <mj-head>
    <mj-title>Verify your WinVane.ai account</mj-title>
    <mj-preview>Verify your email address to activate your WinVane.ai workspace</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#334155" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F8FAFC">
    <mj-section background-color="#0B1220" padding="24px 32px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" color="#FFFFFF" letter-spacing="-0.5px">
          WinVane<span style="color: #3DDC97;">.ai</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="32px 32px 24px 32px">
      <mj-column>
        <mj-text font-size="18px" font-weight="600" color="#0B1220" padding="0 0 16px 0">
          Verify your email address
        </mj-text>
        <mj-text padding="0 0 12px 0">
          Hello {{fullName}},
        </mj-text>
        <mj-text padding="0 0 16px 0">
          Thank you for registering with WinVane.ai. Please confirm your email address by clicking the button below to activate your workspace.
        </mj-text>
        <mj-button background-color="#3DDC97" color="#0B1220" font-weight="600" font-size="14px" border-radius="6px" href="{{verificationUrl}}" padding="24px 0" align="center">
          Verify Email Address
        </mj-button>
        <mj-text font-size="13px" color="#64748B" padding="0 0 8px 0">
          This link expires in {{expiresHours}} hours.
        </mj-text>
        <mj-text font-size="12px" color="#94A3B8" line-height="18px" padding="16px 0 0 0">
          Or copy and paste this link in your browser: <br /><span style="word-break: break-all;">{{verificationUrl}}</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="20px 32px 32px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#64748B" padding="0">
          If you didn't request this, ignore this email.
        </mj-text>
        <mj-text font-size="12px" color="#64748B" padding="4px 0 0 0">
          &copy; {{year}} WinVane.ai. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

