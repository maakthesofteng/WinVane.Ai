<mjml>
  <mj-head>
    <mj-title>Two-factor backup codes regenerated</mj-title>
    <mj-preview>Your WinVane.ai backup recovery codes were regenerated</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#334155" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F8FAFC">
    <mj-section background-color="#0B1220" padding="24px 32px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" color="#FFFFFF" letter-spacing="-0.5px">
          WinVane<span style="color: #3DDC97;">.ai</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="32px 32px 24px 32px">
      <mj-column>
        <mj-text font-size="18px" font-weight="600" color="#0B1220" padding="0 0 16px 0">
          Backup Codes Regenerated
        </mj-text>
        <mj-text padding="0 0 12px 0">
          Hello {{fullName}},
        </mj-text>
        <mj-text padding="0 0 16px 0">
          New two-factor authentication backup recovery codes have been generated for your WinVane.ai account. All previous backup codes are now permanently invalid.
        </mj-text>
        <mj-text color="#DC2626" font-weight="500" padding="0 0 16px 0">
          If you did not regenerate these backup codes, your account credentials may be compromised. Please reset your password and contact support immediately.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="20px 32px 32px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#64748B" padding="0">
          This is an automated security notification regarding your WinVane.ai account.
        </mj-text>
        <mj-text font-size="12px" color="#64748B" padding="4px 0 0 0">
          &copy; {{year}} WinVane.ai. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

