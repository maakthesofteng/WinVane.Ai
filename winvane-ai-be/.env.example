# App
NODE_ENV=development
PORT=5173
API_PREFIX=api/v1
BACKEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=winvane
DB_PASSWORD=change_me
DB_NAME=winvane
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# JWT / session
JWT_SECRET=change_me_min_32_chars_long_jwt_secret_key!
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=wv_session
ADMIN_SESSION_COOKIE_NAME=wv_admin_session
ADMIN_SESSION_TTL_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=30
SESSION_CACHE_TTL_SECONDS=300
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# MFA
MFA_CHALLENGE_COOKIE_NAME=wv_mfa_challenge
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5
MFA_ISSUER=WinVane.ai

# CSRF
CSRF_SECRET=change_me_min_32_chars_long_csrf_secret_key!
CSRF_COOKIE_NAME=wv_csrf

# Encryption at rest (MFA secrets)
DATA_ENCRYPTION_KEY=jnLWCYuqz+r6H3EnwqEE84DUCLk5uN6yL04ISZEHgMs=

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5
ADMIN_AUTH_THROTTLE_LIMIT=5
ADMIN_AUTH_THROTTLE_TTL_SECONDS=900
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ADMIN_LOCKOUT_MINUTES=30

# Mail (Nodemailer) — MAIL_PROVIDER: smtp (Mailpit locally) | ethereal (dev only)
MAIL_PROVIDER=smtp
MAIL_FROM="WinVane.ai <no-reply@winvane.ai>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_TEST_TO=dev@example.com

# Superadmin seed (used by seed script in F12 — never hardcode)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULL_NAME=
