# ==============================================================================
# Root .gitignore for WinVane.ai
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Build and Production Artifacts
/dist/
/.next/
/out/
/build/
*.tsbuildinfo

# Environment & Secret Files (CRITICAL: Never commit real credentials)
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs and Runtime Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test Coverage
/coverage/

# IDE and OS Artifacts
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Prompts and task specifications (user instructions)
prompts/
AGENTS.md
*.md
!README.md
!**/README.md

config.bat
